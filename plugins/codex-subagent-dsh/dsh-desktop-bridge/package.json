{
  "name": "@aototo/codex-subagent-dsh-desktop-bridge",
  "version": "0.1.1",
  "description": "Community desktop connection authorization bridge for codex-subagent-dsh (not an official DeepSeek component)",
  "type": "module",
  "license": "MIT",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "grant.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
